{
  "extends": ["unobtrusive", "unobtrusive/import"],
  "env": {
    "browser": true,
    "node": true,
    "es6": true
  },
  "globals": {
    "nw": false,
    "globalThis": false
  },
  "overrides": [
    {
      "files": ["client/**/*.js"],
      "rules": {
        "import/no-extraneous-dependencies": "off"
      }
    },
    {
      // eslint-import-resolver-node can't follow package.json "exports" subpaths
      "files": ["vitest.config.mjs"],
      "rules": {
        "import/no-unresolved": "off"
      }
    },
    {
      // eslint-plugin-import can't trace named exports through vitest's bundled dist chunks
      "files": ["__tests__/**/*.js"],
      "rules": {
        "import/named": "off"
      }
    }
  ]
}
