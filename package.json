{
  "name": "node-nw",
  "version": "0.7.2",
  "description": "Execute some node script in a headless nw.js instance",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "node-nw": "dist/bin.js"
  },
  "scripts": {
    "build": "tsc && cp src/client/package.json dist/client/package.json",
    "test": "npm run build && vitest run",
    "cli": "env DEBUG='node-nw:*' node dist/bin.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/suchipi/node-nw.git"
  },
  "keywords": [
    "nw",
    "node-webkit"
  ],
  "author": "Lily Skye <me@suchipi.com> (http://suchipi.com)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/suchipi/node-nw/issues"
  },
  "homepage": "https://github.com/suchipi/node-nw#readme",
  "dependencies": {
    "debug": "^4.4.3",
    "mkdirp": "^3.0.1",
    "pipe-wrench": "^1.1.1",
    "rimraf": "^6.1.3",
    "shell-escape": "^0.2.0",
    "supports-color": "^8.1.1",
    "yargs-parser": "^21.1.1"
  },
  "optionalDependencies": {
    "@nwjs-binaries/linux-ia32": "0.87.0-sdk",
    "@nwjs-binaries/linux-x64": "0.87.0-sdk",
    "@nwjs-binaries/osx-arm64": "0.87.0-sdk",
    "@nwjs-binaries/osx-x64": "0.87.0-sdk",
    "@nwjs-binaries/win-ia32": "0.87.0-sdk",
    "@nwjs-binaries/win-x64": "0.87.0-sdk"
  },
  "devDependencies": {
    "@types/debug": "^4.1.13",
    "@types/node": "^26.2.0",
    "@types/shell-escape": "^0.2.3",
    "@types/supports-color": "^8.1.3",
    "@types/yargs-parser": "^21.0.3",
    "first-base": "^4.0.1",
    "prettier": "^3.9.6",
    "strip-ansi": "^6.0.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
